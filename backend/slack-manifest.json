{
  "display_information": {
    "name": "ClearPath Relay",
    "description": "Review concrete creative adjustments and return a decision to Relay.",
    "background_color": "#163d36"
  },
  "features": { "bot_user": { "display_name": "Relay", "always_online": false } },
